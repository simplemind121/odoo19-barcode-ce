<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="barcode_camera_ce.CameraScanDialog">
        <Dialog title="title" size="'md'" footer="false" contentClass="'o_bcce_dialog'">
            <div class="o_bcce_video">
                <t t-if="!state.error">
                    <BarcodeVideoScanner t-key="state.facingMode"
                        facingMode="state.facingMode"
                        delayBetweenScan="props.single ? 0 : 1200"
                        onResult.bind="onResult"
                        onError.bind="onError"
                        cssClass="'w-100 h-100'"/>
                </t>
                <div t-else="" class="o_bcce_error d-flex flex-column align-items-center justify-content-center h-100 p-3 text-center">
                    <i class="fa fa-video-camera fa-2x mb-2"/>
                    <strong>Camera unavailable</strong>
                    <span class="small" t-esc="state.error"/>
                    <span class="small mt-2">The camera needs HTTPS and browser permission. You can still type the code below.</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 mt-2">
                <button class="btn btn-secondary" t-on-click="switchCamera" title="Switch camera">
                    <i class="fa fa-refresh"/>
                </button>
                <form class="flex-grow-1 d-flex gap-2" t-on-submit="submitManual">
                    <input class="form-control o_bcce_manual" t-model="state.manual"
                        placeholder="Type a barcode" autocomplete="off"/>
                    <button class="btn btn-primary o_bcce_manual_add" type="submit">Add</button>
                </form>
            </div>
            <div t-if="state.last" class="o_bcce_last mt-2 small">
                Last scan: <strong t-esc="state.last"/> <span class="text-muted">(<t t-esc="state.count"/> scanned)</span>
            </div>
            <div t-if="!props.single" class="text-end mt-2">
                <button class="btn btn-primary o_bcce_done" t-on-click="() => this.props.close()">Done</button>
            </div>
        </Dialog>
    </t>
</templates>
