<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_bcce" model="ir.ui.view">
        <field name="name">sale.order.form.bcce</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']" position="before">
                <div class="mb-2" invisible="state not in ('draft', 'sent')">
                    <field name="_barcode_scanned" widget="barcode_camera_handler" string="Scan products" nolabel="1"/>
                    <span class="text-muted small ms-2">A hardware scanner also works anywhere on this page.</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
