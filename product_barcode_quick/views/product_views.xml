<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_bcq" model="ir.ui.view">
        <field name="name">product.template.form.bcq</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="barcode" position="attributes">
                <attribute name="widget">barcode_camera_char</attribute>
            </field>
            <field name="barcode" position="after">
                <button name="action_bcq_generate_barcode" type="object" string="Generate in-store barcode"
                        class="btn-link p-0" colspan="2" invisible="barcode or product_variant_count != 1"/>
            </field>
        </field>
    </record>

    <record id="product_normal_form_view_bcq" model="ir.ui.view">
        <field name="name">product.product.form.bcq</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="barcode" position="attributes">
                <attribute name="widget">barcode_camera_char</attribute>
            </field>
        </field>
    </record>

    <record id="action_server_bcq_generate_template" model="ir.actions.server">
        <field name="name">Generate in-store barcodes</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_bcq_generate_barcode()</field>
    </record>
    <record id="action_server_bcq_generate_product" model="ir.actions.server">
        <field name="name">Generate in-store barcodes</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_bcq_generate_barcode()</field>
    </record>

    <record id="action_product_scan" model="ir.actions.client">
        <field name="name">Scan products</field>
        <field name="tag">product_barcode_quick.product_scan</field>
    </record>

    <record id="product_barcode_request_view_list" model="ir.ui.view">
        <field name="name">product.barcode.request.list</field>
        <field name="model">product.barcode.request</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="state != 'open'">
                <field name="create_date" string="First scanned"/>
                <field name="barcode"/>
                <field name="user_id"/>
                <field name="origin"/>
                <field name="count"/>
                <field name="note"/>
                <field name="state"/>
                <field name="product_id"/>
                <button name="action_create_product" type="object" string="Create product" class="btn-link"
                        invisible="state != 'open'"/>
                <button name="action_ignore" type="object" string="Ignore" class="btn-link" invisible="state != 'open'"/>
            </list>
        </field>
    </record>
    <record id="product_barcode_request_view_search" model="ir.ui.view">
        <field name="name">product.barcode.request.search</field>
        <field name="model">product.barcode.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="barcode"/>
                <filter name="open" string="To create" domain="[('state', '=', 'open')]"/>
            </search>
        </field>
    </record>
    <record id="action_product_barcode_request" model="ir.actions.act_window">
        <field name="name">Product requests</field>
        <field name="res_model">product.barcode.request</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
