<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_bcce" model="ir.ui.view">
        <field name="name">stock.picking.form.bcce</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_barcode_ce" type="object" class="oe_stat_button" icon="fa-barcode"
                        invisible="state in ('done', 'cancel')">
                    <div class="o_stat_info"><span class="o_stat_text">Scan</span></div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_batch_form_bcce" model="ir.ui.view">
        <field name="name">stock.picking.batch.form.bcce</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_barcode_ce" type="object" string="Scan" icon="fa-barcode"
                        invisible="state not in ('draft', 'in_progress')"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_type_form_bcce" model="ir.ui.view">
        <field name="name">stock.picking.type.form.bcce</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hardware']" position="before">
                <page name="barcode_rules" string="Barcode rules" invisible="code not in ['incoming', 'outgoing', 'internal']">
                    <p class="text-muted">Rules applied in the Barcode app to scanner operators. Barcode supervisors and inventory users can override "no typed quantities".</p>
                    <group>
                        <group string="Locations" groups="stock.group_stock_multi_locations">
                            <field name="bc_require_source" invisible="code == 'incoming'"/>
                            <field name="bc_require_dest" invisible="code == 'outgoing'"/>
                        </group>
                        <group string="Quantities">
                            <field name="bc_scan_only"/>
                            <field name="bc_block_extra"/>
                            <field name="bc_block_over"/>
                            <field name="bc_require_pack" groups="stock.group_tracking_lot"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Scan log -->
    <record id="stock_barcode_scan_log_view_list" model="ir.ui.view">
        <field name="name">stock.barcode.scan.log.list</field>
        <field name="model">stock.barcode.scan.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="level == 'danger'" decoration-warning="level == 'warning'">
                <field name="create_date" string="Time"/>
                <field name="user_id"/>
                <field name="operation"/>
                <field name="barcode"/>
                <field name="resolved_type" optional="hide"/>
                <field name="product_id"/>
                <field name="lot_name" optional="show"/>
                <field name="location_id" optional="show"/>
                <field name="quantity"/>
                <field name="old_quantity" optional="hide"/>
                <field name="picking_id"/>
                <field name="batch_id" optional="hide"/>
                <field name="level"/>
                <field name="message"/>
                <field name="device" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="stock_barcode_scan_log_view_search" model="ir.ui.view">
        <field name="name">stock.barcode.scan.log.search</field>
        <field name="model">stock.barcode.scan.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="barcode"/>
                <field name="product_id"/>
                <field name="picking_id"/>
                <field name="user_id"/>
                <field name="lot_name"/>
                <field name="location_id"/>
                <filter name="errors" string="Errors" domain="[('level', '=', 'danger')]"/>
                <filter name="manual" string="Typed quantities" domain="[('operation', 'in', ['set_qty', 'add_product', 'inv_set_qty'])]"/>
                <filter name="forced" string="Forced validations" domain="[('operation', '=', 'validate'), ('message', 'ilike', '[force]')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('create_date', '>=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <filter name="create_date" string="Date" date="create_date"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_operation" string="Operation" context="{'group_by': 'operation'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="stock_barcode_scan_log_view_pivot" model="ir.ui.view">
        <field name="name">stock.barcode.scan.log.pivot</field>
        <field name="model">stock.barcode.scan.log</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="user_id" type="row"/>
                <field name="level" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="action_stock_barcode_scan_log" model="ir.actions.act_window">
        <field name="name">Scan log</field>
        <field name="res_model">stock.barcode.scan.log</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <!-- Data check -->
    <record id="stock_barcode_health_view_form" model="ir.ui.view">
        <field name="name">stock.barcode.health.form</field>
        <field name="model">stock.barcode.health</field>
        <field name="arch" type="xml">
            <form string="Barcode data check">
                <header>
                    <button name="action_run" type="object" string="Run check" class="btn-primary"/>
                    <button name="action_generate_missing" type="object" string="Generate in-store barcodes for products without one"
                            invisible="not line_ids" confirm="Generate an in-store barcode for every product listed without a barcode?"/>
                </header>
                <sheet>
                    <p class="text-muted">Finds barcodes that will cause trouble when scanning: wrong check digits, codes the barcode
                        rules read as weight/price/lot, codes used twice, products and storable locations without a barcode.
                        Nothing is changed unless you press a button.</p>
                    <group>
                        <field name="include_missing"/>
                        <field name="summary" invisible="not summary"/>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="category"/>
                            <field name="product_id"/>
                            <field name="location_id"/>
                            <field name="barcode"/>
                            <field name="detail"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_stock_barcode_health" model="ir.actions.act_window">
        <field name="name">Barcode data check</field>
        <field name="res_model">stock.barcode.health</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
