<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_barcode">
        <field name="name">Barcode scanner</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <!-- Scanner-only operator: uses the Barcode app, has no access to the Inventory backend. -->
    <record id="group_barcode_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="sequence">5</field>
        <field name="privilege_id" ref="res_groups_privilege_barcode"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <!-- Supervisor: may override the scan rules (type quantities, validate unscanned, apply counts). -->
    <record id="group_barcode_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_barcode"/>
        <field name="implied_ids" eval="[(4, ref('group_barcode_operator'))]"/>
    </record>
    <!-- Inventory users can already edit everything in the backend: they are supervisors in the scanner. -->
    <record id="stock.group_stock_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_barcode_supervisor'))]"/>
    </record>
</odoo>
